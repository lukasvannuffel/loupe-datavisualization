# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — bypasses RLS. Never expose to the browser.
# Used for storage operations where the SSR client's JWT propagation is unreliable.
# The server action verifies the user via cookies before using this key.
SUPABASE_SERVICE_ROLE_KEY=
